import { LDAP } from "extras://ldap";

function assert_equal($name, $result, $expect)
{
    if (json_encode($result) !== json_encode($expect))
        throw Exception($name . ": FAILED\nRESULT(" . json_encode($result) . ")\nEXPECT(" . json_encode($expect) . ")");
    echo $name . ": OK";
}

$admin = LDAP("ldap://ldap:389");
if (!$admin->bind("cn=admin,dc=example,dc=test", "admin"))
    throw Exception("Test 1: FAILED\n" . LDAP::err2string($admin->errno()));
echo "Test 1: OK";

$result = $admin->search("ou=people,dc=example,dc=test", [
    "scope" => "sub",
    "filter" => "(uid=jane)",
    "attributes" => ["uid", "cn", "mail"]
]);
if (!$result)
    throw Exception("Test 2: FAILED\n" . LDAP::err2string($admin->errno()));
echo "Test 2: OK";

$jane = $result->next();
assert_equal("Test 3", $jane["dn"], "uid=jane,ou=people,dc=example,dc=test");
assert_equal("Test 4", $jane["uid"], ["jane"]);
assert_equal("Test 5", $jane["cn"], ["Jane Doe"]);
assert_equal("Test 6", $jane["mail"], ["jane@example.test"]);
assert_equal("Test 7", $result->next(), false);

// Bind to Jane's account (Since admin has no size limit)
$ldap = LDAP("ldap://ldap:389");
if (!$ldap->bind("uid=jane,ou=people,dc=example,dc=test", "jane"))
    throw Exception("Test 8: FAILED\n" . LDAP::err2string($ldap->errno()));
echo "Test 8: OK";

// This should only return one entry even though two exist since Jane's account has a max size limit of 1
$result = $ldap->search("ou=people,dc=example,dc=test", [
    "scope" => "sub",
    "filter" => "(uid=*)",
]);
if (!$result)
    throw Exception("Test 9: FAILED\n" . LDAP::err2string($ldap->errno()));
echo "Test 9: OK";
$count = 0;
while ($result->next())
    ++$count;
assert_equal("Test 10", $count, 1);

// When using a page size of 1 both entries should be returned
$result = $ldap->search("ou=people,dc=example,dc=test", [
    "scope" => "sub",
    "filter" => "(uid=*)",
    "pagesize" => 1
]);
if (!$result)
    throw Exception("Test 11: FAILED\n" . LDAP::err2string($ldap->errno()));
echo "Test 11: OK";
$count = 0;
while ($result->next())
    ++$count;
assert_equal("Test 12", $count, 2);

// When using a page size larger than the max size limit, the search should fail
$result = $ldap->search("ou=people,dc=example,dc=test", [
    "scope" => "sub",
    "filter" => "(uid=*)",
    "pagesize" => 2
]);
if (!$result)
    throw Exception("Test 13: FAILED\n" . LDAP::err2string($ldap->errno()));
echo "Test 13: OK";
assert_equal("Test 14", $result->next(), none);
assert_equal("Test 15", LDAP::err2string($ldap->errno()), "Administrative limit exceeded");

// An empty DN is valid and should parse to an empty array (used to crash)
assert_equal("Test 16", LDAP::str2dn(""), []);
assert_equal("Test 17", LDAP::str2dn("cn=admin,dc=example,dc=test"), [["cn", "admin"], ["dc", "example"], ["dc", "test"]]);

// dn2str escapes values and round-trips with str2dn
$dn = [["cn", "a,b+c=d\"e\\f<g>h;i"], ["dc", "test"]];
assert_equal("Test 18", LDAP::dn2str($dn), "cn=a\\2Cb\\2Bc\\3Dd\\22e\\5Cf\\3Cg\\3Eh\\3Bi,dc=test");
assert_equal("Test 19", LDAP::str2dn(LDAP::dn2str($dn)), $dn);
assert_equal("Test 20", LDAP::dn2str([["2.5.4.3", "x"], ["x-Attr2", "y"]]), "2.5.4.3=x,x-Attr2=y");

// Attribute types cannot be escaped, so invalid ones must be rejected (not injected into the DN)
$results = [];
foreach (["", "cn,dc=evil", "cn=x", "cn+uid", "c n", "cn;lang-en", "1cn", "-cn", "2.5.", ".2.5", "2..5", "cn\x00"] as $type)
    $results[] = LDAP::dn2str([["dc", "ok"], [$type, "x"]]);
assert_equal("Test 21", $results, [none, none, none, none, none, none, none, none, none, none, none, none]);

// The timeout makes a next() that blocks after the search is complete fail the test instead of hanging
function connect_and_bind($dn, $password)
{
    $ldap = LDAP("ldap://ldap:389");
    $ldap->setoption("timeout", 5);
    if (!$ldap->bind($dn, $password))
        throw Exception("Bind as " . $dn . ": FAILED\n" . LDAP::err2string($ldap->errno()));
    return $ldap;
}

// A failed search must return none (not false, which means no more results) also without a page size
$ldap = connect_and_bind("cn=admin,dc=example,dc=test", "admin");
$result = $ldap->search("ou=nope,dc=example,dc=test");
assert_equal("Test 22", $result->next(), none);
assert_equal("Test 23", LDAP::err2string($ldap->errno()), "No such object");
// The error is returned on every call, with errno set again (here after another operation failed with a bad filter)
$ldap->search("dc=example,dc=test", ["filter" => "(bad"]);
assert_equal("Test 24", [$result->next(), LDAP::err2string($ldap->errno())], [none, "No such object"]);

// When the size limit is exceeded, the entries received are returned first, followed by none on every call
$ldap = connect_and_bind("uid=jane,ou=people,dc=example,dc=test", "jane");
$result = $ldap->search("ou=people,dc=example,dc=test", ["filter" => "(uid=*)"]);
assert_equal("Test 25", [is_array($result->next()), $result->next()], [true, none]);
assert_equal("Test 26", LDAP::err2string($ldap->errno()), "Size limit exceeded");
assert_equal("Test 27", [$result->next(), $result->next(), LDAP::err2string($ldap->errno())], [none, none, "Size limit exceeded"]);

// A successful search ends with false and no error, also when calling next() again (with and without a page size)
$ldap = connect_and_bind("uid=jane,ou=people,dc=example,dc=test", "jane");
$result = $ldap->search("ou=people,dc=example,dc=test", ["filter" => "(uid=jane)"]);
assert_equal("Test 28", [$result->next()["uid"], $result->next(), $result->next()], [["jane"], false, false]);
$result = $ldap->search("ou=people,dc=example,dc=test", ["filter" => "(uid=*)", "pagesize" => 1]);
$count = 0;
while ($result->next())
    ++$count;
assert_equal("Test 29", [$count, $result->next()], [2, false]);
assert_equal("Test 30", $ldap->errno(), 0);

// Unbinding before the search is complete is an error, which (like all errors) is returned on every call
$ldap = connect_and_bind("cn=admin,dc=example,dc=test", "admin");
$result = $ldap->search("ou=people,dc=example,dc=test", ["filter" => "(uid=*)"]);
assert_equal("Test 31", is_array($result->next()), true);
$ldap->unbind();
assert_equal("Test 32", [$result->next(), $result->next()], [none, none]);
assert_equal("Test 33", LDAP::err2string($ldap->errno()), "Can't contact LDAP server");

// str2dn is binary safe: an embedded NUL is an error (not truncated), and an escaped NUL (\00) is part of the value
assert_equal("Test 34", LDAP::str2dn("uid=jane\x00,ou=evil,dc=test"), none);
assert_equal("Test 35", LDAP::str2dn("cn=a\\00b,dc=test"), [["cn", "a\x00b"], ["dc", "test"]]);
assert_equal("Test 36", LDAP::dn2str([["cn", "a\x00b"], ["dc", "test"]]), "cn=a\\00b,dc=test");

// errno is set whenever a method returns none. Each case uses a new LDAP object, so errno can't be left over from an earlier case.
// A bad URI reports the error from ldap_initialize(), also on every call
$ldap = LDAP("htp://nope");
assert_equal("Test 37", [LDAP::err2string($ldap->errno()), $ldap->bind(), LDAP::err2string($ldap->errno())], ["Bad parameter to an ldap routine", none, "Bad parameter to an ldap routine"]);

// Invalid parameter values
$calls = [
    "search base" => function ($l) { return $l->search(5); },
    "search scope" => function ($l) { return $l->search("dc=example,dc=test", ["scope" => "subtree"]); },
    "search pagesize" => function ($l) { return $l->search("dc=example,dc=test", ["pagesize" => 1.5]); },
    "setoption name" => function ($l) { return $l->setoption(5, 1); },
    "setoption unknown" => function ($l) { return $l->setoption("nope", 1); },
    "setoption protocol_version" => function ($l) { return $l->setoption("protocol_version", "3"); },
    "setoption referrals" => function ($l) { return $l->setoption("referrals", 1); },
    "setoption network_timeout" => function ($l) { return $l->setoption("network_timeout", "5"); },
    "setoption timeout" => function ($l) { return $l->setoption("timeout", "5"); },
    "setoption timelimit" => function ($l) { return $l->setoption("timelimit", "5"); },
    "setoption tls_verify_peer" => function ($l) { return $l->setoption("tls_verify_peer", 1); },
    "getoption unknown" => function ($l) { return $l->getoption("nope"); },
    "bind dn" => function ($l) { return $l->bind(5); },
    "bind password" => function ($l) { return $l->bind("cn=admin,dc=example,dc=test", 5); }
];
$results = [];
$expected = [];
foreach ($calls as $name => $call)
{
    $ldap = LDAP("ldap://ldap:389");
    $results[$name] = [$call($ldap), LDAP::err2string($ldap->errno())];
    $expected[$name] = [none, "Bad parameter to an ldap routine"];
}
assert_equal("Test 38", $results, $expected);

// After unbind() every method fails with "Can't contact LDAP server"
$calls = [
    "search" => function ($l) { return $l->search("dc=example,dc=test"); },
    "bind" => function ($l) { return $l->bind(); },
    "starttls" => function ($l) { return $l->starttls(); },
    "setoption" => function ($l) { return $l->setoption("timelimit", 5); },
    "getoption" => function ($l) { return $l->getoption("diagnostic_message"); },
    "getpeerx509" => function ($l) { return $l->getpeerx509(); },
    "unbind" => function ($l) { return $l->unbind(); }
];
$results = [];
$expected = [];
foreach ($calls as $name => $call)
{
    $ldap = connect_and_bind("cn=admin,dc=example,dc=test", "admin");
    $ldap->unbind();
    $results[$name] = [$call($ldap), LDAP::err2string($ldap->errno())];
    $expected[$name] = [none, "Can't contact LDAP server"];
}
assert_equal("Test 39", $results, $expected);

// filter_escape escapes the special characters (and NUL), and escaping nothing is an empty string
assert_equal("Test 40", [LDAP::filter_escape(""), LDAP::filter_escape("plain"), LDAP::filter_escape("a*(b)\\c\x00")], ["", "plain", "a\\2A\\28b\\29\\5Cc\\00"]);
